{
  "name": "tfme-auto",
  "version": "0.1.0",
  "private": true,
  "description": "TFME Auto — standalone workshop management SaaS",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "docs:api": "tsx scripts/gen-api-docs.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "db:generate": "prisma generate",
    "db:local": "tsx scripts/dev-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/server/jobs/worker-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit-gate.cjs",
    "platform": "tsx scripts/platform.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "nodemailer": "^10.0.14",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.27",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
