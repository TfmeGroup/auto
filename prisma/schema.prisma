  @@unique([id, businessId, vehicleId, customerId])
  @@unique([businessId, jobNumber])
  @@unique([bookingId, businessId])
  @@index([businessId, status, openedAt(sort: Desc)])
  @@index([businessId, primaryTechnicianMembershipId, status])
  @@index([businessId, customerId])
  @@index([businessId, vehicleId])
  @@map("job_cards")
}

model JobTechnician {
