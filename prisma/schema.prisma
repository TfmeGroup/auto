// ───────── Workshop configuration ─────────

model ServiceType {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String       @map("business_id") @db.Uuid
  name                   String
  defaultDurationMin     Int          @default(60) @map("default_duration_min")
  // What an hour of labour costs the customer for this kind of service (overrides the business default).
  labourRateCentsPerHour Int?         @map("labour_rate_cents_per_hour")
  status                 RecordStatus @default(ACTIVE)
  sortOrder              Int          @default(0) @map("sort_order")
  // Part 7 service catalogue.
  description            String?
  defaultPriceCents      Int?         @map("default_price_cents")
  taxTreatment           TaxTreatment @default(STANDARD) @map("tax_treatment")
  checklist              String[]     @default([])
  defaultParts           Json         @default("[]") @map("default_parts")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  templates JobTemplate[]

  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("service_types")
}

model Bay {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  locationId String?      @map("location_id") @db.Uuid
  name       String
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("bays")
}

// One row per business. Absent row = the defaults below.
model WorkshopSettings {
  businessId               String   @id @map("business_id") @db.Uuid
  // false = a technician cannot be booked into two overlapping appointments.
  allowTechnicianOverlap   Boolean  @default(false) @map("allow_technician_overlap")
  // Maximum appointments (bookings) that may overlap at once across the workshop; null = unlimited.
  maxConcurrentJobs        Int?     @map("max_concurrent_jobs")
  requireCheckInSignature  Boolean  @default(false) @map("require_checkin_signature")
  requireRescheduleReason  Boolean  @default(false) @map("require_reschedule_reason")
  notifyCustomerReschedule Boolean  @default(true) @map("notify_customer_on_reschedule")
  notifyCustomerCancel     Boolean  @default(true) @map("notify_customer_on_cancel")
  // Part 7 booking rules.
  bufferMinutes            Int      @default(0) @map("buffer_minutes")
  minLeadMinutes           Int      @default(0) @map("min_lead_minutes")
  cancelWindowHours        Int      @default(0) @map("cancel_window_hours")
  maxDailyBookings         Int?     @map("max_daily_bookings")
  allowWalkIns             Boolean  @default(true) @map("allow_walk_ins")
  waitingListEnabled       Boolean  @default(true) @map("waiting_list_enabled")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("workshop_settings")
}

// Opening hours; several rows per weekday are allowed (a gap is a break). 0 = Sunday.
model WorkshopHours {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String @map("business_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  @@index([businessId, weekday])
  @@map("workshop_hours")
}

// A technician's own working hours. No rows at all = the workshop's hours apply.
model TechnicianSchedule {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String @map("business_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  weekday      Int
  startMinute  Int    @map("start_minute")
  endMinute    Int    @map("end_minute")

  @@index([businessId, membershipId, weekday])
  @@map("technician_schedules")
}

model TechnicianTimeOff {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String      @map("business_id") @db.Uuid
  membershipId String      @map("membership_id") @db.Uuid
  kind         TimeOffKind @default(LEAVE)
  startsAt     DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime    @map("ends_at") @db.Timestamptz(3)
  reason       String?
  createdById  String?     @map("created_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([businessId, membershipId, startsAt])
  @@map("technician_time_off")
}

// ───────── Vehicles ─────────

model Vehicle {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String        @map("business_id") @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  registration     String?
  // Upper-case letters and digits only; what uniqueness and search use.
  registrationNorm String?       @map("registration_norm")
  vin              String?
  make             String?
  model            String?
  year             Int?
  variant          String?
  colour           String?
  engine           String?
  engineSizeCc     Int?          @map("engine_size_cc")
  fuelType         FuelType?     @map("fuel_type")
  transmission     Transmission?
  driveType        DriveType?    @map("drive_type")
  // Latest accepted odometer reading (kept in step with vehicle_mileage_log by the service).
  mileageKm        Int?          @map("mileage_km")
  status           VehicleStatus @default(ACTIVE)
  notes            String?
  createdById      String?       @map("created_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(3)

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer  Customer          @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  contacts  VehicleContact[]
  mileage   VehicleMileage[]
  intervals ServiceInterval[]
  jobs      JobCard[]
  bookings  Booking[]
  quotes    Quote[]
  invoices  Invoice[]

  @@unique([id, businessId])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@map("vehicles")
}

model VehicleContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  vehicleId    String   @map("vehicle_id") @db.Uuid
  name         String
  mobile       String?
  email        String?
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, vehicleId])
  @@map("vehicle_contacts")
}

// Append-only odometer history. A correction is a new row, never an edit.
model VehicleMileage {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String        @map("business_id") @db.Uuid
  vehicleId    String        @map("vehicle_id") @db.Uuid
  mileageKm    Int           @map("mileage_km")
  source       MileageSource
  jobId        String?       @map("job_id") @db.Uuid
  bookingId    String?       @map("booking_id") @db.Uuid
  isCorrection Boolean       @default(false) @map("is_correction")
  note         String?
  recordedById String?       @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, vehicleId, recordedAt(sort: Desc)])
  @@map("vehicle_mileage_log")
}

// Maintenance schedule: due by distance, by time, or both (whichever comes first).
model ServiceInterval {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  serviceTypeId String?   @map("service_type_id") @db.Uuid
  name          String
  everyKm       Int?      @map("every_km")
  everyMonths   Int?      @map("every_months")
  lastServiceAt DateTime? @map("last_service_at") @db.Timestamptz(3)
  lastServiceKm Int?      @map("last_service_km")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, vehicleId])
  @@map("service_intervals")
}

// ───────── Bookings ─────────

model RecurringBookingRule {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String              @map("business_id") @db.Uuid
  customerId             String              @map("customer_id") @db.Uuid
  vehicleId              String              @map("vehicle_id") @db.Uuid
  serviceTypeId          String?             @map("service_type_id") @db.Uuid
  serviceLabel           String              @map("service_label")
  technicianMembershipId String?             @map("technician_membership_id") @db.Uuid
  bayId                  String?             @map("bay_id") @db.Uuid
  locationId             String?             @map("location_id") @db.Uuid
  frequency              RecurrenceFrequency
  intervalCount          Int                 @default(1) @map("interval_count")
  // Local (business time) calendar date and minute-of-day of the first occurrence.
  startDate              DateTime            @map("start_date") @db.Date
  startMinute            Int                 @map("start_minute")
  durationMin            Int                 @map("duration_min")
  endDate                DateTime?           @map("end_date") @db.Date
  occurrences            Int?
  status                 RuleStatus          @default(ACTIVE)
  notes                  String?
  createdById            String?             @map("created_by_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("recurring_booking_rules")
}

model Booking {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String        @map("business_id") @db.Uuid
  bookingNumber          String        @map("booking_number")
  customerId             String        @map("customer_id") @db.Uuid
  vehicleId              String        @map("vehicle_id") @db.Uuid
  serviceTypeId          String?       @map("service_type_id") @db.Uuid
  // The service name as it was when booked, so renaming the catalogue never rewrites history.
  serviceLabel           String        @map("service_label")
  startsAt               DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt                 DateTime      @map("ends_at") @db.Timestamptz(3)
  durationMin            Int           @map("duration_min")
  technicianMembershipId String?       @map("technician_membership_id") @db.Uuid
  bayId                  String?       @map("bay_id") @db.Uuid
  locationId             String?       @map("location_id") @db.Uuid
  status                 BookingStatus @default(CONFIRMED)
  isWalkIn               Boolean       @default(false) @map("is_walk_in")
  recurringRuleId        String?       @map("recurring_rule_id") @db.Uuid
  customerNotes          String?       @map("customer_notes")
  internalNotes          String?       @map("internal_notes")
  expectedMileageKm      Int?          @map("expected_mileage_km")
  reminderSentAt         DateTime?     @map("reminder_sent_at") @db.Timestamptz(3)
  checkedInAt            DateTime?     @map("checked_in_at") @db.Timestamptz(3)
  cancelledAt            DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById          String?       @map("cancelled_by_id") @db.Uuid
  cancelReason           String?       @map("cancel_reason")
  createdById            String?       @map("created_by_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer       @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  vehicle  Vehicle        @relation(fields: [vehicleId, businessId], references: [id, businessId], onDelete: Restrict)
  events   BookingEvent[]
  job      JobCard?

  @@unique([id, businessId])
  @@unique([businessId, bookingNumber])
  @@index([businessId, startsAt])
  @@index([businessId, status, startsAt])
  @@index([businessId, technicianMembershipId, startsAt])
  @@index([businessId, customerId])
  @@index([businessId, vehicleId])
  @@map("bookings")
}

// Append-only booking history (created, rescheduled with old/new times, cancelled, status changes...).
model BookingEvent {
