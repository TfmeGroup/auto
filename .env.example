# TFME Auto — environment configuration.
# Copy to .env for local development. Never commit real secrets.
# In production, supply these through your host's secret manager, not a file.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_URL         : the restricted "tfme_app" role the running app uses (row-level security applies).
# MIGRATE_DATABASE_URL : the schema owner, used only by `npm run db:migrate`. Never give the web app this.
# `npm run db:local` starts a local Postgres and prints working values for both.
DATABASE_URL=postgresql://tfme_app:tfme_app_dev_password@localhost:54320/tfme_auto
MIGRATE_DATABASE_URL=postgresql://postgres:password@localhost:54320/tfme_auto

# ── Auth ─────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
# Set true ONLY behind a reverse proxy you control (Vercel, nginx, a load balancer) that sets
# x-real-ip / x-forwarded-for. Needed so per-IP rate limits see real client IPs.
TRUST_PROXY=false

# 32-byte key (base64) encrypting MFA secrets at rest. REQUIRED in production (the app refuses to boot without it).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in your secret manager; losing it means users must re-enrol MFA. Dev/test fall back to a fixed dev-only key.
# MFA_ENCRYPTION_KEY=

# ── Email ────────────────────────────────────────────────────────────────
# console = print emails (with their one-time links) to the server log. Development only.
EMAIL_DRIVER=console
EMAIL_FROM="TFME Auto <Tech@tfme.co.za>"
# EMAIL_DRIVER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ── SMS / WhatsApp (optional; leave as none until a provider account exists) ──
# none = those channels are recorded as "skipped: not configured". The Twilio driver sends transactional messages only.
SMS_DRIVER=none
WHATSAPP_DRIVER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+27000000000
# TWILIO_WHATSAPP_FROM=whatsapp:+27000000000

# ── Documents: signed download links and malware scanning ────────────────
# FILE_SIGNING_KEY signs short-lived download links. REQUIRED in production. Dev/test use a fixed dev-only key.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FILE_SIGNING_KEY=
# CLAMAV_HOST=localhost       # a clamd daemon; when set, uploads are scanned and fail closed if it is unreachable
# CLAMAV_PORT=3310

# ── File storage (private) ───────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
MAX_UPLOAD_MB=25
# STORAGE_DRIVER=s3          # S3 / Cloudflare R2 / Supabase Storage (S3 API) / MinIO. Bucket MUST be private.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ── Billing ──────────────────────────────────────────────────────────────
# none = trial only; checkout is disabled until a provider is configured.
BILLING_PROVIDER=none
TRIAL_DAYS=14
# BILLING_PROVIDER=payfast
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=true       # must be false in production

# ── Background jobs ──────────────────────────────────────────────────────
# true = run the worker inside the web process (dev / single instance). Otherwise run `npm run worker`.
JOBS_INLINE_WORKER=true
