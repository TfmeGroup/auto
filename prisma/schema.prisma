// TFME Auto — database schema (PostgreSQL).
//
// Conventions
//  * snake_case columns/tables in the database, camelCase in code.
//  * uuid primary keys (gen_random_uuid()), timestamptz timestamps.
//  * Money is stored as integer minor units (cents) — never floats.
//  * Every business-owned table carries business_id. Data-plane tables are also
//    protected by Postgres row-level security (see migrations/*_security).
//  * Emails are stored lower-cased (enforced by a CHECK constraint).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE

  @@map("auth_token_type")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED

  @@map("business_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("membership_status")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum RecordStatus {
  ACTIVE
  ARCHIVED

  @@map("record_status")
}

enum FileStatus {
  ACTIVE
  ARCHIVED
  TRASHED
  DELETED

  @@map("file_status")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD

  @@map("job_status")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  GRACE_PERIOD
  SUSPENDED

  @@map("subscription_status")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED

  @@map("webhook_status")
}

enum PaymentRecordStatus {
  PENDING
  COMPLETE
  FAILED
  CANCELLED

  @@map("payment_record_status")
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  passwordHash        String     @map("password_hash")
  firstName           String     @default("") @map("first_name")
  lastName            String     @default("") @map("last_name")
  // Display name; maintained by the service as "first last".
  name                String
  mobile              String?
  profilePhotoKey     String?    @map("profile_photo_key")
  status              UserStatus @default(ACTIVE)
  deactivatedAt       DateTime?  @map("deactivated_at") @db.Timestamptz(3)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp         String?    @map("last_login_ip")
  lastLoginUserAgent  String?    @map("last_login_user_agent")
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  // MFA (TOTP). Secrets are AES-256-GCM encrypted; recovery codes are stored hashed.
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  mfaEnabledAt        DateTime?  @map("mfa_enabled_at") @db.Timestamptz(3)
  mfaSecretEnc        String?    @map("mfa_secret_enc")
  mfaPendingSecretEnc String?    @map("mfa_pending_secret_enc")
  // Last accepted TOTP time-step: a code can never be used twice.
  mfaLastUsedStep     Int        @default(0) @map("mfa_last_used_step")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  authTokens        AuthToken[]
  memberships       Membership[]
  mfaChallenges     MfaChallenge[]
  recoveryCodes     MfaRecoveryCode[]
  notificationPrefs UserNotificationPreference[]
  platformAdmin     PlatformAdmin?

  @@map("users")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  // Currently selected workspace. Validated against an ACTIVE membership on every request.
  activeBusinessId String?   @map("active_business_id") @db.Uuid
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  // For EMAIL_CHANGE: the address being switched to (not trusted until the link is used).
  newEmail  String?       @map("new_email")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model MfaChallenge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  attempts  Int       @default(0)
  ip        String?
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// Optional (non-security) email categories a person can switch off. Security alerts are never optional.
model UserNotificationPreference {
  userId       String  @map("user_id") @db.Uuid
  category     String
  emailEnabled Boolean @default(true) @map("email_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("user_notification_preferences")
}

model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
}

// Platform-wide tunables (trial reminders, grace periods, retention). Defaults live in code.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

// ───────────────────────── Business & membership ─────────────────────────

model Business {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  tradingName         String?        @map("trading_name")
  legalName           String?        @map("legal_name")
  businessType        String?        @map("business_type")
  registrationNumber  String?        @map("registration_number")
  vatNumber           String?        @map("vat_number")
  vatRegistered       Boolean        @default(false) @map("vat_registered")
  // VAT rate in basis points (1500 = 15.00%). Business-level so it is not hard-coded to ZA.
  vatRateBps          Int            @default(1500) @map("vat_rate_bps")
  currency            String         @default("ZAR") @db.Char(3)
  countryCode         String         @default("ZA") @map("country_code") @db.Char(2)
  timezone            String         @default("Africa/Johannesburg")
  locale              String         @default("en-ZA")
  phone               String?
  email               String?
  website             String?
  addressLine1        String?        @map("address_line1")
  addressLine2        String?        @map("address_line2")
  city                String?
  province            String?
  postalCode          String?        @map("postal_code")
  billingAddressLine1 String?        @map("billing_address_line1")
  billingAddressLine2 String?        @map("billing_address_line2")
  billingCity         String?        @map("billing_city")
  billingProvince     String?        @map("billing_province")
  billingPostalCode   String?        @map("billing_postal_code")
  logoFileId          String?        @map("logo_file_id") @db.Uuid
  // When true, members must have MFA enabled to use the business (plan entitlement: mfa_enforcement).
  requireMfa          Boolean        @default(false) @map("require_mfa")
  status              BusinessStatus @default(ACTIVE)
  createdById         String?        @map("created_by_id") @db.Uuid
  closedAt            DateTime?      @map("closed_at") @db.Timestamptz(3)
  closedById          String?        @map("closed_by_id") @db.Uuid
  closeReason         String?        @map("close_reason")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt          DateTime?      @map("archived_at") @db.Timestamptz(3)

  memberships     Membership[]
  roles           Role[]
  locations       Location[]
  customers       Customer[]
  files           File[]
  subscription    Subscription?
  numberSequences NumberSequence[]
  invoices        SubscriptionInvoice[]
  exports         DataExport[]
  vehicles        Vehicle[]
  bookings        Booking[]
  jobCards        JobCard[]
  financeSettings FinanceSettings?
  quotes          Quote[]
  invoicesIssued  Invoice[]
  payments        Payment[]
  refunds         Refund[]
  receipts        Receipt[]
  creditNotes     CreditNote[]
  config          BusinessConfig?
  jobTemplates    JobTemplate[]
  savedReports    SavedReport[]
  reportSchedules ReportSchedule[]
  reportRuns      ReportRun[]
  importBatches   ImportBatch[]
  importRows      ImportRow[]

  @@map("businesses")
}

model DataExport {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String       @map("business_id") @db.Uuid
  requestedById String?      @map("requested_by_id") @db.Uuid
  status        ExportStatus @default(PENDING)
  // Datasets requested, already filtered to what the requester was allowed to export.
  scope         String[]
  storageKey    String?      @unique @map("storage_key")
  sizeBytes     Int?         @map("size_bytes")
  sha256        String?
  error         String?
  requestedAt   DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, requestedAt(sort: Desc)])
  @@map("data_exports")
}

model Location {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String       @map("business_id") @db.Uuid
  name         String
  isDefault    Boolean      @default(false) @map("is_default")
  // Optional short code (e.g. CPT) put into this location's document numbers: INV-CPT-000001.
  docCode      String?      @map("doc_code")
  addressLine1 String?      @map("address_line1")
  city         String?
  province     String?
  postalCode   String?      @map("postal_code")
  phone        String?
  email        String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  access   MembershipLocation[]

  @@unique([id, businessId])
  @@index([businessId])
  @@map("locations")
}

// System roles have business_id NULL and are immutable. Custom roles (a later
// feature) are business-owned rows in the same table.
model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String?   @map("business_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  // Custom roles are archived, never deleted, so history keeps pointing at them.
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@index([businessId])
  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model Membership {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String           @map("business_id") @db.Uuid
  // NULL while an invitation is outstanding and unclaimed.
  userId                 String?          @map("user_id") @db.Uuid
  roleId                 String           @map("role_id") @db.Uuid
  status                 MembershipStatus @default(INVITED)
  // Maintained by a database trigger: true when the role is the system Owner role.
  // A partial unique index allows exactly one ACTIVE owner per business.
  isOwner                Boolean          @default(false) @map("is_owner")
  invitedEmail           String?          @map("invited_email")
  inviteTokenHash        String?          @unique @map("invite_token_hash")
  inviteExpiresAt        DateTime?        @map("invite_expires_at") @db.Timestamptz(3)
  invitedById            String?          @map("invited_by_id") @db.Uuid
  invitedAt              DateTime?        @map("invited_at") @db.Timestamptz(3)
  joinedAt               DateTime?        @map("joined_at") @db.Timestamptz(3)
  // When true the member may use every location; otherwise only MembershipLocation rows.
  allLocations           Boolean          @default(true) @map("all_locations")
  // What an hour of this person's time costs the business (operational gross profit only; never shown to customers).
  labourCostCentsPerHour Int?             @map("labour_cost_cents_per_hour")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  locations MembershipLocation[]

  @@unique([id, businessId])
  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, status])
  @@map("memberships")
}

model MembershipLocation {
  membershipId String @map("membership_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@map("membership_locations")
}

// Per-business, per-document-kind counters (CUST-0001, JOB-1045, ...).
model NumberSequence {
  businessId String   @map("business_id") @db.Uuid
  kind       String
  prefix     String
  nextValue  Int      @default(1) @map("next_value")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, kind])
  @@map("number_sequences")
}

// ───────────────────────── Audit ─────────────────────────

// Append-only: a database trigger rejects UPDATE/DELETE, and the application
// role is only granted SELECT + INSERT.
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String?  @map("business_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, resourceType, resourceId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ───────────────────────── Files ─────────────────────────

model File {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String             @map("business_id") @db.Uuid
  uploadedById   String?            @map("uploaded_by_id") @db.Uuid
  storageKey     String             @unique @map("storage_key")
  originalName   String             @map("original_name")
  mimeType       String             @map("mime_type")
  sizeBytes      Int                @map("size_bytes")
  sha256         String
  // Polymorphic association to the owning record (customer, job, vehicle, ...).
  resourceType   String?            @map("resource_type")
  resourceId     String?            @map("resource_id")
  status         FileStatus         @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(3)
  // Part 6: the shared document system.
  displayName    String?            @map("display_name")
  extension      String?
  description    String?
  category       String             @default("OTHER")
  visibility     DocumentVisibility @default(INTERNAL)
  version        Int                @default(1)
  versionGroupId String?            @map("version_group_id") @db.Uuid
  isCurrent      Boolean            @default(true) @map("is_current")
  source         FileSource         @default(UPLOAD)
  generatedKind  String?            @map("generated_kind")
  generatedRef   String?            @map("generated_ref")
  locationId     String?            @map("location_id") @db.Uuid
  customerId     String?            @map("customer_id") @db.Uuid
  scanStatus     ScanStatus         @default(NOT_SCANNED) @map("scan_status")
  scannedAt      DateTime?          @map("scanned_at") @db.Timestamptz(3)
  thumbnailKey   String?            @map("thumbnail_key")
  isFinancial    Boolean            @default(false) @map("is_financial")
  retainUntil    DateTime?          @map("retain_until") @db.Timestamptz(3)
  trashedAt      DateTime?          @map("trashed_at") @db.Timestamptz(3)
  trashedById    String?            @map("trashed_by_id") @db.Uuid
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, resourceType, resourceId])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, status, category])
  @@index([businessId, customerId, createdAt(sort: Desc)])
  @@index([businessId, uploadedById, createdAt(sort: Desc)])
  @@index([businessId, visibility])
  @@index([businessId, versionGroupId, version])
  @@map("files")
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String?
  linkUrl    String?   @map("link_url")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Part 6: structured notifications.
  priority   String    @default("NORMAL")
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  groupKey   String?   @map("group_key")
  groupCount Int       @default(1) @map("group_count")

  @@index([businessId, userId, readAt, createdAt(sort: Desc)])
  @@index([businessId, userId, groupKey])
  @@map("notifications")
}

// ───────────────────────── Background jobs & infra ─────────────────────────

model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  // Prevents duplicate enqueueing of the same logical job (e.g. one email per event).
  dedupeKey   String?   @unique @map("dedupe_key")
  businessId  String?   @map("business_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@map("jobs")
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now()) @map("window_start") @db.Timestamptz(3)

  @@map("rate_limit_buckets")
}

// ───────────────────────── Billing ─────────────────────────

model Plan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String          @unique
  name            String
  // Price per billing interval in minor units (cents), VAT-exclusive. NULL = not priced yet:
  // such a plan cannot be purchased online (checkout refuses) until pricing is configured.
  priceCents      Int?            @map("price_cents")
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  maxMembers      Int             @map("max_members")
  maxLocations    Int             @map("max_locations")
  maxStorageMb    Int             @map("max_storage_mb")
  // Self-serve plans can be bought online; custom plans are assigned by the platform team.
  isCustom        Boolean         @default(false) @map("is_custom")
  isPublic        Boolean         @default(true) @map("is_public")
  status          PlanStatus      @default(ACTIVE)
  effectiveFrom   DateTime?       @map("effective_from") @db.Timestamptz(3)
  effectiveTo     DateTime?       @map("effective_to") @db.Timestamptz(3)
  sortOrder       Int             @default(0) @map("sort_order")

  features      PlanFeature[]
  subscriptions Subscription[]        @relation("CurrentPlan")
  pendingFor    Subscription[]        @relation("PendingPlan")
  payments      SubscriptionPayment[]

  @@map("plans")
}

// Feature entitlements per plan. A missing row means "not included".
model PlanFeature {
  planId     String  @map("plan_id") @db.Uuid
  featureKey String  @map("feature_key")
  enabled    Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_features")
}

model Subscription {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId              String             @unique @map("business_id") @db.Uuid
  planId                  String             @map("plan_id") @db.Uuid
  status                  SubscriptionStatus @default(TRIALING)
  trialStartedAt          DateTime?          @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt             DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  // Set when a paid subscription first starts after a trial.
  convertedAt             DateTime?          @map("converted_at") @db.Timestamptz(3)
  currentPeriodStart      DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd        DateTime?          @map("current_period_end") @db.Timestamptz(3)
  // When a payment first failed (or the paid period lapsed unpaid). Drives past-due -> grace -> suspended.
  pastDueSince            DateTime?          @map("past_due_since") @db.Timestamptz(3)
  cancelAtPeriodEnd       Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt              DateTime?          @map("canceled_at") @db.Timestamptz(3)
  canceledById            String?            @map("canceled_by_id") @db.Uuid
  cancelReason            String?            @map("cancel_reason")
  // A scheduled downgrade, applied when the current paid period ends.
  pendingPlanId           String?            @map("pending_plan_id") @db.Uuid
  pendingChangeAt         DateTime?          @map("pending_change_at") @db.Timestamptz(3)
  // Contract overrides for CUSTOM plans (set by the platform team only).
  overrideMaxMembers      Int?               @map("override_max_members")
  overrideMaxLocations    Int?               @map("override_max_locations")
  overrideMaxStorageMb    Int?               @map("override_max_storage_mb")
  provider                String?
  providerSubscriptionRef String?            @map("provider_subscription_ref")
  // Display-only summary from the provider (e.g. "Visa ending 4242"); never card data.
  paymentMethodSummary    String?            @map("payment_method_summary")
  // What the provider will charge per period from now on. Recurring webhooks are checked against this.
  recurringAmountCents    Int?               @map("recurring_amount_cents")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        Plan                  @relation("CurrentPlan", fields: [planId], references: [id])
  pendingPlan Plan?                 @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  payments    SubscriptionPayment[]
  invoices    SubscriptionInvoice[]

  @@map("subscriptions")
}

// A tax invoice TFME issues to the business for each completed subscription payment.
model SubscriptionInvoice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  paymentId      String   @unique @map("payment_id") @db.Uuid
  number         String   @unique
  planName       String   @map("plan_name")
  description    String
  subtotalCents  Int      @map("subtotal_cents")
  vatCents       Int      @map("vat_cents")
  totalCents     Int      @map("total_cents")
  vatRateBps     Int      @map("vat_rate_bps")
  currency       String   @default("ZAR") @db.Char(3)
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([businessId, issuedAt(sort: Desc)])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String              @map("business_id") @db.Uuid
  subscriptionId    String              @map("subscription_id") @db.Uuid
  // Plan being purchased; applied to the subscription when the payment completes.
  planId            String              @map("plan_id") @db.Uuid
  provider          String
  // Null until the provider reports a payment id for this attempt.
  providerPaymentId String?             @map("provider_payment_id")
  amountCents       Int                 @map("amount_cents")
  status            PaymentRecordStatus
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@index([businessId])
  @@map("subscription_payments")
}

// Every inbound webhook is stored before it is processed. (provider, external_id)
// is the idempotency key that makes redelivery harmless.
model WebhookEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       String
  externalId     String        @map("external_id")
  eventType      String        @map("event_type")
  payload        Json
  signatureValid Boolean       @map("signature_valid")
  status         WebhookStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime?     @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@map("webhook_events")
}

// ───────────────────────── Customers (reference module) ─────────────────────────
// Deliberately minimal: it exists to prove the full module pattern (schema, RLS,
// permissions, audit, search, pagination, API, UI). Part 2 extends it.

model Customer {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId         String         @map("business_id") @db.Uuid
  customerNumber     String         @map("customer_number")
  type               CustomerType   @default(INDIVIDUAL)
  // Display/search name, maintained by the service as "first last".
  name               String
  firstName          String         @default("") @map("first_name")
  lastName           String         @default("") @map("last_name")
  companyName        String?        @map("company_name")
  companyRegNumber   String?        @map("company_registration_number")
  idNumber           String?        @map("id_number")
  email              String?
  mobile             String?
  altPhone           String?        @map("alt_phone")
  preferredContact   ContactMethod? @map("preferred_contact")
  marketingConsent   Boolean        @default(false) @map("marketing_consent")
  marketingConsentAt DateTime?      @map("marketing_consent_at") @db.Timestamptz(3)
  emergencyName      String?        @map("emergency_contact_name")
  emergencyPhone     String?        @map("emergency_contact_phone")
  addressLine1       String?        @map("address_line1")
  addressLine2       String?        @map("address_line2")
  city               String?
  province           String?
  postalCode         String?        @map("postal_code")
  notes              String?
  status             CustomerStatus @default(ACTIVE)
  createdById        String?        @map("created_by_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?      @map("archived_at") @db.Timestamptz(3)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  vehicles      Vehicle[]
  jobs          JobCard[]
  bookings      Booking[]
  quotes        Quote[]
  invoices      Invoice[]
  payments      Payment[]
  creditNotes   CreditNote[]
  creditEntries CustomerCreditEntry[]

  // (id, business_id) lets other tables use a composite FK so a vehicle/job can
  // never point at a customer from a different business.
  @@unique([id, businessId])
  @@unique([businessId, customerNumber])
  @@index([businessId, status, createdAt(sort: Desc)])
  @@map("customers")
}

