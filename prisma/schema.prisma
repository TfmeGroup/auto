// ───────── Job cards ─────────

model JobCard {
  id                            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                    String         @map("business_id") @db.Uuid
  jobNumber                     String         @map("job_number")
  customerId                    String         @map("customer_id") @db.Uuid
  vehicleId                     String         @map("vehicle_id") @db.Uuid
  bookingId                     String?        @map("booking_id") @db.Uuid
  status                        JobCardStatus  @default(CHECKED_IN)
  // Where the job resumes when taken off hold.
  heldFromStatus                JobCardStatus? @map("held_from_status")
  priority                      JobPriority    @default(NORMAL)
  serviceTypeId                 String?        @map("service_type_id") @db.Uuid
  serviceLabel                  String?        @map("service_label")
  complaint                     String?
  isWalkIn                      Boolean        @default(false) @map("is_walk_in")
  mileageInKm                   Int?           @map("mileage_in_km")
  mileageOutKm                  Int?           @map("mileage_out_km")
  primaryTechnicianMembershipId String?        @map("primary_technician_membership_id") @db.Uuid
  advisorMembershipId           String?        @map("advisor_membership_id") @db.Uuid
  locationId                    String?        @map("location_id") @db.Uuid
  bayId                         String?        @map("bay_id") @db.Uuid
  estimatedCompletionAt         DateTime?      @map("estimated_completion_at") @db.Timestamptz(3)
  openedAt                      DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  completedAt                   DateTime?      @map("completed_at") @db.Timestamptz(3)
  completedById                 String?        @map("completed_by_id") @db.Uuid
  completionSummary             String?        @map("completion_summary")
  cancelledAt                   DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason                  String?        @map("cancel_reason")
  createdById                   String?        @map("created_by_id") @db.Uuid
  createdAt                     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer      Customer          @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  vehicle       Vehicle           @relation(fields: [vehicleId, businessId], references: [id, businessId], onDelete: Restrict)
  booking       Booking?          @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict)
