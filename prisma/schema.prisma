  @@map("job_notes")
}

model JobPhoto {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String        @map("business_id") @db.Uuid
  jobId            String        @map("job_id") @db.Uuid
  vehicleId        String        @map("vehicle_id") @db.Uuid
